# Public Supabase values from the same project used by roboticscenter.ai.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>

# Comma-separated post-recovery/logout origins. Preview values are added only
# to the Vercel Preview scope. Paths and credentials are never configured here.
AUTH_ALLOWED_RETURN_ORIGINS=https://<website-preview>.vercel.app
# Server-only JSON map. Each OAuth client is bound to only its exact callbacks.
AUTH_ALLOWED_OAUTH_CLIENTS={"<website-preview-oauth-client-id>":["https://<website-preview>.vercel.app/auth/sso/callback"],"<centeros-staging-desktop-oauth-client-id>":["centeros-staging://auth/callback"],"<centeros-desktop-oauth-client-id>":["centeros://auth/callback"]}
